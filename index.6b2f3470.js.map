"use strict";
// write code here
function parseSalary(salaryStr) {
    var withoutDollar = salaryStr.slice(1);
    var withoutComma = withoutDollar.replace(",", "");
    return parseFloat(withoutComma);
}
function sortList(list) {
    var ul = list[0].parentElement;
    var sortedItems = Array.from(list).sort(function(a, b) {
        return parseSalary(b.dataset.salary) - parseSalary(a.dataset.salary);
    });
    ul.innerHTML = "";
    sortedItems.forEach(function(item) {
        return ul.appendChild(item);
    });
}
function getEmployees(list) {
    return Array.from(list).map(function(item) {
        return {
            name: item.textContent.trim(),
            position: item.dataset.position,
            salary: parseSalary(item.dataset.salary),
            age: parseInt(item.dataset.age)
        };
    });
}
var allList = document.querySelectorAll("ul > li");
sortList(allList);
getEmployees(allList);

